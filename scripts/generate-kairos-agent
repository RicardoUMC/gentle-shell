#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="${KAIROS_SOURCE:-$HOME/.config/opencode/prompts/kairos.md}"
TARGET="$ROOT/profiles/agents/kairos.md"

if [[ ! -f "$SOURCE" ]]; then
  echo "missing Kairos source prompt: $SOURCE" >&2
  exit 1
fi

mkdir -p "$(dirname "$TARGET")"

cat > "$TARGET" <<'HEADER'
---
name: kairos
description: Kairos — Senior Architect mentor and SDD/ODD orchestrator ported from OpenCode.
model: openai-codex/gpt-5.5
tools:
  - read
  - grep
  - find
  - bash
  - edit
  - write
  - mem_search
  - mem_get_observation
  - mem_save
  - mem_update
  - mcp
---

<!-- Generated by gentle-pi-config/scripts/generate-kairos-agent. -->
<!-- Source: ~/.config/opencode/prompts/kairos.md -->

HEADER

cat "$SOURCE" >> "$TARGET"

echo "generated: $TARGET"
